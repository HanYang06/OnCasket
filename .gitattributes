# ============================================================================
# 行尾策略：仓库内一律 LF
#
# 本机 core.autocrlf=true 会把 CRLF 塞回工作区，因此必须由本文件显式声明
# eol=lf —— .gitattributes 的优先级高于 core.autocrlf。
#
# 历史文件的一次性归一化：git add --renormalize .
# ============================================================================

* text=auto eol=lf

# ---------------------------------------------------------------------------
# 二进制（禁止任何行尾与文本转换）
# ---------------------------------------------------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.bmp   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.whl   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pyc   binary

# ---------------------------------------------------------------------------
# 生成物：不参与 diff，且不计入语言统计
# ---------------------------------------------------------------------------
uv.lock                 -diff linguist-generated=true
THIRD_PARTY_NOTICES.md  linguist-generated=true

# ---------------------------------------------------------------------------
# 文档
# ---------------------------------------------------------------------------
docs/**                 linguist-documentation=true
*.md                    text

# 变更日志索引会被并行分支同时追加，取并集避免无意义冲突；版本文件一版一份，本身不冲突
docs/CHANGELOG/index.md merge=union

# ---------------------------------------------------------------------------
# 归档时的导出控制
# ---------------------------------------------------------------------------
.github/                export-ignore
tests/                  export-ignore
docs/                   export-ignore
scripts/                export-ignore
.pre-commit-config.yaml export-ignore
